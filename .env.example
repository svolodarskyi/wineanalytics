# OpenAI API key, server-side only.
OPENAI_API_KEY=

# Same key, exposed to client-side code via Vite's VITE_ prefix convention.
# Local experimentation only - never use this for a deployed build, since
# it ends up readable in the browser bundle.
VITE_OPENAI_API_KEY=

# Supabase project credentials (https://supabase.com/dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
