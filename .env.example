# OpenAI API key, server-side only.
OPENAI_API_KEY=

# Same key, exposed to client-side code via Vite's VITE_ prefix convention.
# Local experimentation only - never use this for a deployed build, since
# it ends up readable in the browser bundle.
VITE_OPENAI_API_KEY=

# Supabase project credentials (https://supabase.com/dashboard -> Project Settings -> API)
# Exposed to client-side code via Vite's VITE_ prefix convention.
VITE_SUPABASE_URL=
# The publishable key (formerly "anon key"). Safe to ship to the client -
# Row Level Security is what actually protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Same URL, without the VITE_ prefix, for server-side/admin scripts (seeding, migrations).
SUPABASE_URL=
# The secret key (formerly "service_role key"). Bypasses Row Level Security -
# server-side/admin scripts only, never expose this to the client.
SUPABASE_SECRET_KEY=
