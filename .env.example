# OpenAI API key, server-side only.
OPENAI_API_KEY=

# Same key, exposed to client-side code via Vite's VITE_ prefix convention.
# Local experimentation only - never use this for a deployed build, since
# it ends up readable in the browser bundle.
VITE_OPENAI_API_KEY=

# Supabase project credentials (https://supabase.com/dashboard)
SUPABASE_URL=
# Server-side/admin only - bypasses Row Level Security. Never expose this to the client.
SUPABASE_SERVICE_KEY=

# Same URL, exposed to client-side code via Vite's VITE_ prefix convention.
VITE_SUPABASE_URL=
# The anon/public key (Project Settings -> API), NOT the service key above.
# Safe to ship to the client - Row Level Security is what protects the data.
VITE_SUPABASE_ANON_KEY=
